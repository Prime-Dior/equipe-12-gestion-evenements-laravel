{
    "openapi": "3.0.0",
    "info": {
        "title": "Eventia API",
        "description": "API REST de gestion des événements et des inscriptions. Les routes protégées utilisent des jetons Laravel Sanctum.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "Serveur de développement"
        }
    ],
    "paths": {
        "/api/v1/auth/register": {
            "post": {
                "tags": [
                    "Authentification"
                ],
                "summary": "Créer un compte et obtenir un jeton",
                "operationId": "b9e746d77661fb8df55d0ac63e1ece77",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation",
                                    "device_name"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Amina User",
                                        "maxLength": 100
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "amina@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123",
                                        "minLength": 8
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    },
                                    "device_name": {
                                        "type": "string",
                                        "example": "mobile",
                                        "maxLength": 100
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Compte créé.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthToken"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Données invalides ou adresse e-mail déjà utilisée.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/login": {
            "post": {
                "tags": [
                    "Authentification"
                ],
                "summary": "Se connecter et obtenir un jeton",
                "operationId": "a7997e7c1e3bfed64d4e56de82415931",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password",
                                    "device_name"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "amina@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    },
                                    "device_name": {
                                        "type": "string",
                                        "example": "mobile",
                                        "maxLength": 100
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Connexion réussie.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthToken"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Identifiants invalides.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Trop de tentatives de connexion."
                    }
                }
            }
        },
        "/api/v1/auth/me": {
            "get": {
                "tags": [
                    "Authentification"
                ],
                "summary": "Afficher le compte connecté",
                "operationId": "37d33f0281f67d31d05b4c45eea0143b",
                "responses": {
                    "200": {
                        "description": "Compte connecté.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Jeton absent ou invalide."
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "tags": [
                    "Authentification"
                ],
                "summary": "Révoquer le jeton courant",
                "operationId": "f6b8957b4c0b25636613a9f0512a8ba9",
                "responses": {
                    "204": {
                        "description": "Déconnexion réussie."
                    },
                    "401": {
                        "description": "Jeton absent ou invalide."
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/events": {
            "get": {
                "tags": [
                    "Événements"
                ],
                "summary": "Lister les événements à venir",
                "operationId": "1845dc9126717378ecce57f9863a2775",
                "parameters": [
                    {
                        "name": "q",
                        "in": "query",
                        "description": "Recherche dans le titre.",
                        "schema": {
                            "type": "string",
                            "maxLength": 120
                        }
                    },
                    {
                        "name": "category",
                        "in": "query",
                        "description": "Identifiant de catégorie.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "date",
                        "in": "query",
                        "description": "Filtrer par date (AAAA-MM-JJ).",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "description": "Résultats par page (1 à 100).",
                        "schema": {
                            "type": "integer",
                            "default": 15,
                            "maximum": 100,
                            "minimum": 1
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Numéro de page.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Liste paginée des événements.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Event"
                                            }
                                        },
                                        "current_page": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "last_page": {
                                            "type": "integer",
                                            "example": 3
                                        },
                                        "per_page": {
                                            "type": "integer",
                                            "example": 15
                                        },
                                        "total": {
                                            "type": "integer",
                                            "example": 36
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Filtres invalides.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Événements"
                ],
                "summary": "Créer un événement (administrateur)",
                "operationId": "446e16eabb76930dc344352554f87ec9",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "category_id",
                                    "title",
                                    "description",
                                    "date",
                                    "location",
                                    "capacity"
                                ],
                                "properties": {
                                    "category_id": {
                                        "type": "integer",
                                        "example": 2
                                    },
                                    "title": {
                                        "type": "string",
                                        "example": "Fabrique ton premier site",
                                        "maxLength": 160
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Un atelier pratique.",
                                        "maxLength": 5000
                                    },
                                    "date": {
                                        "type": "string",
                                        "format": "date-time",
                                        "example": "2026-12-10T14:00:00"
                                    },
                                    "location": {
                                        "type": "string",
                                        "example": "Cotonou",
                                        "maxLength": 180
                                    },
                                    "capacity": {
                                        "type": "integer",
                                        "example": 30,
                                        "maximum": 100000,
                                        "minimum": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Événement créé.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Event"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Authentification requise."
                    },
                    "403": {
                        "description": "Rôle administrateur requis."
                    },
                    "422": {
                        "description": "Données invalides.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/events/{event}": {
            "get": {
                "tags": [
                    "Événements"
                ],
                "summary": "Afficher un événement",
                "operationId": "468d5f9db2c450fe14488f9b3807ebdb",
                "parameters": [
                    {
                        "name": "event",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Événement trouvé.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Event"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Événement introuvable."
                    }
                }
            },
            "put": {
                "tags": [
                    "Événements"
                ],
                "summary": "Modifier un événement (administrateur)",
                "operationId": "09aeb67f45e52f445a7f9227faac883e",
                "parameters": [
                    {
                        "name": "event",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "category_id",
                                    "title",
                                    "description",
                                    "date",
                                    "location",
                                    "capacity"
                                ],
                                "properties": {
                                    "category_id": {
                                        "type": "integer",
                                        "example": 2
                                    },
                                    "title": {
                                        "type": "string",
                                        "example": "Fabrique ton premier site",
                                        "maxLength": 160
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Un atelier pratique.",
                                        "maxLength": 5000
                                    },
                                    "date": {
                                        "type": "string",
                                        "format": "date-time",
                                        "example": "2026-12-10T14:00:00"
                                    },
                                    "location": {
                                        "type": "string",
                                        "example": "Cotonou",
                                        "maxLength": 180
                                    },
                                    "capacity": {
                                        "type": "integer",
                                        "example": 30,
                                        "maximum": 100000,
                                        "minimum": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Événement modifié.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Event"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Authentification requise."
                    },
                    "403": {
                        "description": "Rôle administrateur requis."
                    },
                    "404": {
                        "description": "Événement introuvable."
                    },
                    "422": {
                        "description": "Données invalides ou capacité insuffisante.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Événements"
                ],
                "summary": "Supprimer un événement (administrateur)",
                "operationId": "e79ae9c9478f254e77b493b67cad6b7e",
                "parameters": [
                    {
                        "name": "event",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Événement supprimé."
                    },
                    "401": {
                        "description": "Authentification requise."
                    },
                    "403": {
                        "description": "Rôle administrateur requis."
                    },
                    "404": {
                        "description": "Événement introuvable."
                    },
                    "409": {
                        "description": "L’événement possède des inscriptions."
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/registrations": {
            "get": {
                "tags": [
                    "Inscriptions"
                ],
                "summary": "Lister mes inscriptions",
                "operationId": "93349ec1746858f5594f4159cedd736a",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Numéro de page.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Liste paginée des inscriptions de l’utilisateur connecté.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Registration"
                                            }
                                        },
                                        "current_page": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "last_page": {
                                            "type": "integer",
                                            "example": 2
                                        },
                                        "per_page": {
                                            "type": "integer",
                                            "example": 15
                                        },
                                        "total": {
                                            "type": "integer",
                                            "example": 20
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Jeton absent ou invalide."
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Inscriptions"
                ],
                "summary": "S’inscrire à un événement",
                "operationId": "47f65963b1027e1bb019c42219c38cad",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "event_id"
                                ],
                                "properties": {
                                    "event_id": {
                                        "type": "integer",
                                        "example": 7
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Inscription créée.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Registration"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Jeton absent ou invalide."
                    },
                    "404": {
                        "description": "Événement introuvable."
                    },
                    "422": {
                        "description": "Événement passé, complet, déjà réservé ou identifiant invalide.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/registrations/{registration}": {
            "get": {
                "tags": [
                    "Inscriptions"
                ],
                "summary": "Afficher une de mes inscriptions",
                "operationId": "b21bf9aa93baaffef166bbe45d6b7a7c",
                "parameters": [
                    {
                        "name": "registration",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Inscription trouvée.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Registration"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Jeton absent ou invalide."
                    },
                    "404": {
                        "description": "Inscription introuvable ou ne vous appartenant pas."
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Inscriptions"
                ],
                "summary": "Annuler une de mes inscriptions",
                "operationId": "319b6e584c80ef8a189467bc8f8c1f8f",
                "parameters": [
                    {
                        "name": "registration",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Inscription annulée."
                    },
                    "401": {
                        "description": "Jeton absent ou invalide."
                    },
                    "404": {
                        "description": "Inscription introuvable ou ne vous appartenant pas."
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "User": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Amina User"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "amina@example.com"
                    },
                    "role": {
                        "type": "string",
                        "example": "user"
                    }
                },
                "type": "object"
            },
            "AuthToken": {
                "properties": {
                    "user": {
                        "$ref": "#/components/schemas/User"
                    },
                    "token": {
                        "type": "string",
                        "example": "1|sanctum-personal-access-token"
                    }
                },
                "type": "object"
            },
            "Category": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 2
                    },
                    "name": {
                        "type": "string",
                        "example": "Atelier"
                    }
                },
                "type": "object"
            },
            "Event": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 7
                    },
                    "category_id": {
                        "type": "integer",
                        "example": 2
                    },
                    "title": {
                        "type": "string",
                        "example": "Fabrique ton premier site"
                    },
                    "description": {
                        "type": "string",
                        "example": "Un atelier pratique pour découvrir le HTML."
                    },
                    "date": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-12-10T14:00:00.000000Z"
                    },
                    "location": {
                        "type": "string",
                        "example": "Cotonou"
                    },
                    "capacity": {
                        "type": "integer",
                        "example": 30
                    },
                    "registrations_count": {
                        "type": "integer",
                        "example": 12
                    },
                    "category": {
                        "$ref": "#/components/schemas/Category"
                    }
                },
                "type": "object"
            },
            "Registration": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 4
                    },
                    "user_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "event_id": {
                        "type": "integer",
                        "example": 7
                    },
                    "event": {
                        "$ref": "#/components/schemas/Event"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "ValidationError": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Les données fournies sont invalides."
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "description": "Utilisez le jeton Sanctum obtenu à l’inscription ou à la connexion.",
                "bearerFormat": "Bearer",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Authentification",
            "description": "Inscription, connexion et gestion du jeton"
        },
        {
            "name": "Événements",
            "description": "Consultation des événements et gestion réservée aux administrateurs"
        },
        {
            "name": "Inscriptions",
            "description": "Gestion des inscriptions de l’utilisateur connecté"
        }
    ]
}